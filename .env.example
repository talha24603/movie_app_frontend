# Base URL of the FastAPI backend as seen by the BROWSER. Leave empty to use same-origin /api
# (Vite dev proxy or the nginx container), which is recommended: the admin session cookie stays first-party.
# If you point this at another origin (e.g. http://localhost:8000), add this app's origin to the
# backend's CORS_ORIGINS.
VITE_API_URL=

# Dev server only: where Vite proxies /api. From inside a container use the service name (http://api:8000),
# not localhost.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
